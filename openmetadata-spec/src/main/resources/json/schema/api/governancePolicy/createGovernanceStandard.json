{
  "$id": "https://open-metadata.org/schema/api/governancePolicy/createGovernanceStandard.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateGovernanceStandardRequest",
  "description": "Create a Governance Standard entity request",
  "type": "object",
  "javaType": "org.openmetadata.schema.api.governancePolicy.CreateGovernanceStandard",
  "javaInterfaces": [
    "org.openmetadata.schema.CreateEntity"
  ],
  "properties": {
    "name": {
      "description": "Name that identifies this standard within its parent policy.",
      "$ref": "../../type/basic.json#/definitions/entityName"
    },
    "displayName": {
      "description": "Display Name that identifies this standard for display purposes.",
      "type": "string"
    },
    "description": {
      "description": "Description of the standard.",
      "$ref": "../../type/basic.json#/definitions/markdown"
    },
    "parent": {
      "description": "Reference to the parent Governance Policy.",
      "$ref": "../../type/basic.json#/definitions/entityName"
    },
    "rule": {
      "description": "Rule definition or guidance text for this standard.",
      "type": "string"
    },
    "owners": {
      "description": "Owners of this standard.",
      "$ref": "../../type/entityReferenceList.json",
      "default": null
    },
    "tags": {
      "description": "Tags for this standard.",
      "type": "array",
      "items": {
        "$ref": "../../type/tagLabel.json"
      },
      "default": null
    },
    "extension": {
      "description": "Entity extension data with custom attributes added to the entity.",
      "$ref": "../../type/basic.json#/definitions/entityExtension"
    }
  },
  "required": ["name", "description", "parent"],
  "additionalProperties": false
}
